# Forex API Keys
FOREX_PROVIDER=demo
FOREX_API_KEY=your-api-key-here
FOREX_API_SECRET=your-api-secret-here
FOREX_ACCOUNT_ID=your-account-id-here

# Server Settings
PORT=3000
AUTO_START=true
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/forex_bot
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Trading Settings
TRADING_MIN_CONFIDENCE=0.6
TRADING_MAX_VOLATILITY=0.02
TRADING_MAX_RISK_PER_TRADE=0.02
TRADING_STOP_LOSS_PERCENT=0.02
TRADING_TAKE_PROFIT_PERCENT=0.04
TRADING_MAX_POSITIONS=5
TRADING_MAX_LEVERAGE=10
